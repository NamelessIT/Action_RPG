  id: RavagerSkill
  skillName: Sacrificial Strike
  icon: {fileID: 0}
  skilDesc: "\"\u2022 H\xE0nh \u0111\u1ED9ng: Trong 5 gi\xE2y ti\u1EBFp theo, t\u0103ng
    200% attackSpeed, 200% physicalAtk, 20% Crit Damage v\xE0 20% t\u1ED1c \u0111\u1ED9
    di chuy\u1EC3n v\xE0 \u0111\xF2n \u0111\xE1nh kh\xF4ng ti\xEAu hao m\xE1u n\u1EEFa.
    \nTuy nhi\xEAn, nh\xE2n v\u1EADt s\u1EBD t\u1EF1 \u0111\u1ED9ng \u0111\xE1nh,
    kh\xF4ng th\u1EC3 \u0111i\u1EC1u khi\u1EC3n v\xE0 kh\xF4ng th\u1EC3 h\u1ED3i
    m\xE1u.\n\n\u2022 Hi\u1EC7u \u1EE9ng: Nh\u1EADn l\xE1 ch\u1EAFn b\u1EB1ng 50%
    m\xE1u t\u1ED1i \u0111a, khi k\u1EBFt th\xFAc hi\u1EC7u \u1EE9ng s\u1EBD \u0111\u01B0\u1EE3c
    h\u1ED3i l\u1EA1i 30% m\xE1u t\u1ED1i \u0111a v\xE0 l\xE0m cho\xE1ng k\u1EBB
    \u0111\u1ECBch xung quanh 1,5 gi\xE2y.\n\n\u2022 Design: L\u1ED1i ch\u01A1i \"\"\u0111\u01B0\u1EE3c
    \u0103n c\u1EA3, ng\xE3 v\u1EC1 kh\xF4ng\"\". \u0110\xE1nh \u0111\u1ED5i t\xEDnh
    m\u1EA1ng \u0111\u1EC3 l\u1EA5y s\xE1t th\u01B0\u01A1ng t\u1ED1i \u0111a.\""
