  skilDesc: "\"\u2022 H\xE0nh \u0111\u1ED9ng: Leonard b\u1EAFn lu\u1ED3ng n\u0103ng
    l\u01B0\u1EE3ng qu\xE1 t\u1EA3i v\xE0o Companion.\n\n\u2022 Hi\u1EC7u \u1EE9ng:
    Companion nh\u1EADn gi\xE1p \u1EA3o trong 4 gi\xE2y, khi\xEAu kh\xEDch \u0111\u1ECBch,
    t\u1EF1 ch\u1EA1y v\xE0o n\u01A1i \u0111\xF4ng k\u1EBB \u0111\u1ECBch nh\u1EA5t.
    Khi \u0111\xE3 v\xE0o n\u01A1i \u0111\xF4ng nh\u1EA5t ho\u1EB7c sau 4 gi\xE2y,
    gi\xE1p \u1EA3o ph\xE1t n\u1ED5, g\xE2y s\xE1t th\u01B0\u01A1ng v\xE0 l\xE0m
    cho\xE1ng AOE.\n\n\u2022 Design: Bi\u1EBFn Companion th\xE0nh \"\"tr\u1EE5 ph\xE9p
    di \u0111\u1ED9ng\"\" \u0111\u1EC3 d\u1ECDn l\xEDnh.\""
