  id: RogueSignature
  skillName: "Thousand C\xFAt"
  icon: {fileID: 0}
  skilDesc: "\"H\xE0nh \u0111\u1ED9ng: Leonard bi\u1EBFn th\xE0nh b\xF3ng \u0111en,
    l\u01B0\u1EDBt qua l\u1EA1i li\xEAn t\u1EE5c gi\u1EEFa t\u1EA5t c\u1EA3 k\u1EBB
    \u0111\u1ECBch trong m\xE0n h\xECnh.\n\nHi\u1EC7u \u1EE9ng: Ch\xE9m 12 nh\xE1t
    t\u1EEB sau l\u01B0ng chia \u0111\u1EC1u cho to\xE0n b\u1ED9 k\u1EBB \u0111\u1ECBch
    ho\u1EB7c 6 n\u1EBFu c\xF3 m\u1ED9t k\u1EBB \u0111\u1ECBch. Sau khi k\u1EBFt
    th\xFAc s\u1EBD d\u1ECBch chuy\u1EC3n ra sau l\u01B0ng k\u1EBB \u0111\u1ECBch
    c\xF2n nhi\u1EC1u m\xE1u nh\u1EA5t. Leonard II b\u1EA5t t\u1EED trong th\u1EDDi
    gian thi tri\u1EC3n.\""
